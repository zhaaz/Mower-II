+            "measurement_plans",
+            "data/messungen/messplaene",
+        ),
+    }
+    for key, (legacy_value, new_value) in replacements.items():
+        current = str(migrated.get(key, "")).strip().replace("\\", "/").rstrip("/")
+        if not current or current == legacy_value:
